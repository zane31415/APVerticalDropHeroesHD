# --- the game itself -------------------------------------------------------
# Never commit game files. data.win is the game's own content, and a patched
# data.win is a derivative of it -- ship the patcher, not the patched game.
Vertical Drop Heroes HD/

# --- third-party binaries (build inputs, fetched not vendored) -------------
mod/build/utmt/
gm-apclientpp.dll

# --- build outputs ---------------------------------------------------------
# Everything in out/ is reproducible: python mod/build/package.py
out/
mod/build/build.log
*.apworld

# --- decompiled game code --------------------------------------------------
# Verification dumps from `UndertaleModCli dump` are the GAME's own decompiled
# source, not ours. Never commit these; they are the one thing in this tree
# that would be republishing Nerdook's code.
mod/build/chk*/
mod/build/verify/
mod/build/dump*/
**/CodeEntries/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
