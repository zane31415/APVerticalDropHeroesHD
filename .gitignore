# --- the game itself -------------------------------------------------------
# Never commit game files. data.win is the game's own content, and a patched
# data.win is a derivative of it -- ship the patcher, not the patched game.
Vertical Drop Heroes HD/

# --- third-party (vendored as zips, unpacked as build outputs) -------------
# The archives in mod/third-party/ ARE committed, exactly as upstream published
# them -- that is what lets a player extract one zip and run patch.bat, and it
# is how the GPL source for UndertaleModTool stays with the binary it belongs
# to. See mod/third-party/README.md. What is ignored is the unpacked forms,
# which vendor.py recreates from those archives on demand.
mod/build/utmt/
gm-apclientpp.dll

# --- build outputs ---------------------------------------------------------
# Everything in out/ is reproducible: python mod/build/package.py
out/
mod/build/build.log
*.apworld

# --- decompiled game code --------------------------------------------------
# Verification dumps from `UndertaleModCli dump` are the GAME's own decompiled
# source, not ours. Never commit these; they are the one thing in this tree
# that would be republishing Nerdook's code.
mod/build/chk*/
mod/build/verify/
mod/build/dump*/
**/CodeEntries/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
